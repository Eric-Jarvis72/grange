# Copy to .env for local development. Never commit .env - repo-sanity.mjs
# rejects it. In production these live in systemd's EnvironmentFile
# (see deploy/grange.service).

# Days a login session stays valid before it must be signed in again.
SESSION_TTL_DAYS=30

# Required to call POST /api/reset when NODE_ENV=production. The endpoint wipes
# game state and all accounts, so it refuses unauthenticated calls in production.
# Generate with: openssl rand -hex 32
RESET_KEY=
