{
  "name": "grange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/bootstrap.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "postinstall": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "predev": "node scripts/bootstrap.mjs",
    "dev": "concurrently -k -n backend,web -c blue,magenta \"pnpm dev:backend\" \"pnpm dev:web\"",
    "dev:backend": "node scripts/run-mix.mjs phx.server",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "art:cards": "node scripts/generate-card-art.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:backend": "node scripts/run-mix.mjs test",
    "test:e2e": "vite build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "biome lint src shared && node scripts/max-lines.mjs && pnpm sanity",
    "lint:backend": "node scripts/run-mix.mjs format --check-formatted && node scripts/run-mix.mjs credo --strict",
    "sanity": "node scripts/repo-sanity.mjs",
    "check": "pnpm lint && pnpm test && pnpm test:backend && pnpm build",
    "format": "biome format --write",
    "start": "node scripts/run-mix.mjs phx.server"
  },
  "dependencies": {
    "@fontsource/rye": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "excalibur": "0.32.0",
    "phoenix": "^1.8.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/phoenix": "^1.6.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
