{
  "name": "grange",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite-node server/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "biome lint && node scripts/max-lines.mjs && pnpm sanity",
    "sanity": "node scripts/repo-sanity.mjs",
    "check": "pnpm lint && pnpm test && pnpm build",
    "format": "biome format --write",
    "start": "NODE_ENV=production vite-node server/index.ts"
  },
  "dependencies": {
    "@fontsource/rye": "^5.3.0",
    "@react-spring/konva": "^9.7.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "excalibur": "0.32.0",
    "express": "^4.19.2",
    "konva": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-router-dom": "^6.26.0",
    "react-spring": "^9.7.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "vite": "^5.4.0",
    "vite-express": "^0.16.0",
    "vite-node": "^2.0.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
